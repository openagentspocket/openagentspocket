{
  "name": "agentico-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "verify-fast": "node scripts/verify-fast.mjs",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gen": "pnpm -F @openagentspocket/core gen && pnpm -F @openagentspocket/ui gen",
    "gen:check": "pnpm -F @openagentspocket/core gen:check && pnpm -F @openagentspocket/ui gen:check",
    "e2e:ios": "maestro test e2e/home.yaml",
    "progress": "node scripts/progress.mjs",
    "sim:verify": "node scripts/sim-verify.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  }
}
