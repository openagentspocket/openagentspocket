+    /// Removes generated config files that an earlier process left in the
+    /// temporary directory (for example one killed between writing and
+    /// loading its config). Called once per process before any config is
+    /// written, so no live controller owns any of them.
+    static func removeStaleManagedConfigs() {
+        let fileManager = FileManager.default
+        let directory = fileManager.temporaryDirectory
+        guard let names = try? fileManager.contentsOfDirectory(atPath: directory.path) else { return }
+        for name in names
+            where name.hasPrefix(managedConfigPrefix) && name.hasSuffix(".\(managedConfigExtension)")
+        {
+            try? fileManager.removeItem(at: directory.appendingPathComponent(name))
+        }
+    }
