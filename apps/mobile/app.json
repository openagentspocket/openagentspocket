{
  "expo": {
    "name": "Agents Pocket",
    "slug": "openagentspocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["openagentspocket", "agentico"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.openagentspocket.app",
      "deploymentTarget": "18.0",
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": ["group.com.openagentspocket.app"]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.openagentspocket.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock OpenAgentsPocket with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpenAgentsPocket uses the camera to scan the Pairing Code shown on your computer, so you can add that machine without typing anything.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "OpenAgentsPocket uses the microphone to dictate into your Agent's draft.",
          "speechRecognitionPermission": "OpenAgentsPocket turns what you dictate into text for your Agent's draft."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@bacons/apple-targets",
      "./plugins/withLocalPreview"
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
